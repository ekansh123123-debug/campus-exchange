  "description": "CampusExchange Express.js API and MongoDB persistence layer",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build:check": "node --check src/server.js && node --check src/app.js",
    "lint": "node src/scripts/lint-check.js",
