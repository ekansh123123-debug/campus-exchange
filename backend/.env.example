# CampusExchange Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
API_BASE_URL=http://localhost:5000/api/v1
MONGODB_URI=mongodb://localhost:27017/campus_exchange
USE_IN_MEMORY_DB_IF_UNAVAILABLE=true

# Allowed student email domains (comma separated)
COLLEGE_EMAIL_DOMAINS=nitk.edu.in,campus.edu,example.edu

# Authentication Secrets & Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14
JWT_ISSUER=campus-exchange-api
JWT_AUDIENCE=campus-exchange-client
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Mailer Configuration (SMTP)
EMAIL_FROM=CampusExchange <no-reply@example.edu>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ImageKit Configuration (Optional: fallback to local uploads if omitted)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_RESOURCE_FOLDER=/campus-exchange/resources
IMAGEKIT_LISTING_FOLDER=/campus-exchange/listings

# Application Constraints
MAX_LISTING_IMAGES=6
MAX_IMAGE_SIZE_MB=5
MAX_RESOURCE_SIZE_MB=20
RESERVATION_EXPIRY_HOURS=48
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Cookie Names & Logging
ACCESS_TOKEN_COOKIE_NAME=exchange-app-token
REFRESH_COOKIE_NAME=exchange-app-refresh-token
CSRF_COOKIE_NAME=ce_csrf
LOG_LEVEL=info
