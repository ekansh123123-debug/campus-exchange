{
  "name": "campus-exchange",
  "version": "1.0.0",
  "private": true,
  "description": "CampusExchange — Verified college marketplace and PYQ/study-resource library",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm --workspace backend run start",
    "dev": "node scripts/dev.js",
    "dev:client": "npm --workspace frontend run dev",
    "dev:server": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build && npm --workspace backend run build:check",
    "preview": "node scripts/preview.js",
    "preview:client": "npm --workspace frontend run preview",
    "lint": "npm --workspace frontend run lint && npm --workspace backend run lint",
    "format:check": "node scripts/format-check.js",
    "test": "npm --workspace backend run test && npm --workspace frontend run test",
    "test:server": "npm --workspace backend run test",
    "test:backend": "npm --workspace backend run test",
    "test:client": "npm --workspace frontend run test",
    "test:frontend": "npm --workspace frontend run test",
    "seed:categories": "npm --workspace backend run seed:categories",
    "seed:demo": "npm --workspace backend run seed:demo",
    "admin:create": "npm --workspace backend run admin:create",
    "seed:admin": "npm --workspace backend run admin:create"
  }
}
