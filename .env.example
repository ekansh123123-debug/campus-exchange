# CampusExchange Environment Configuration (Safe Placeholders Only)
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
API_BASE_URL=http://localhost:5000/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/campus_exchange
USE_IN_MEMORY_DB_IF_UNAVAILABLE=true

# Allowed college email domains (comma-separated, lowercase)
COLLEGE_EMAIL_DOMAINS=nitk.edu.in,campus.edu,example.edu

# JWT & Session Settings (Replace with long random secrets in production)
JWT_ACCESS_SECRET=replace-with-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-different-long-random-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14
JWT_ISSUER=campus-exchange-api
JWT_AUDIENCE=campus-exchange-client
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Email / OTP Delivery Settings (Leave SMTP_HOST empty in local dev to use safe local outbox preview)
EMAIL_FROM=CampusExchange <no-reply@example.edu>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ImageKit Media Storage Settings (Leave empty in local dev/test to use local controlled storage adapter)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_RESOURCE_FOLDER=/campus-exchange/resources
IMAGEKIT_LISTING_FOLDER=/campus-exchange/listings

# Upload & Business Policy Limits
MAX_LISTING_IMAGES=6
MAX_IMAGE_SIZE_MB=5
MAX_RESOURCE_SIZE_MB=20
RESERVATION_EXPIRY_HOURS=48
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Cookie & Header Names
ACCESS_TOKEN_COOKIE_NAME=
REFRESH_COOKIE_NAME=ce_refresh
CSRF_COOKIE_NAME=ce_csrf
LOG_LEVEL=info
